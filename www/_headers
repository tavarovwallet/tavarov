# Заголовки кэша для Cloudflare Pages.
#
# Формат тот же, что у Netlify, поэтому файл лежит прямо в www и работает
# на обоих хостингах сразу. Дублировать правила в двух местах нельзя:
# рано или поздно они разойдутся, и мы полдня будем искать, почему на одном
# хостинге свежая сборка, а на другом прошлогодняя.

# Кошелёк нельзя встраивать в чужую страницу рамкой. Это не перестраховка:
# невидимая рамка поверх чужой кнопки — самый дешёвый способ заставить
# человека нажать «Отправить» в своём же кошельке, думая, что он нажимает
# что-то другое. Правило общее на весь сайт: встраивать здесь нечего.
# Strict-Transport-Security: браузер год ходит сюда только по https —
# подменить страницу кошелька в открытом Wi-Fi не выйдет.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000

# Само приложение и служебный работник — всегда проверять, нет ли свежего.
# Файлы маленькие, задержки не видно. Без этого человек открывает сайт после
# обновления и видит прошлую версию: мы на этом уже обжигались.
# ЗАЩИТА КОШЕЛЬКА ОТ ВНЕДРЁННОГО КОДА (аудит 10.11.2026). Страница кошелька
# может обращаться только к перечисленным узлам сетей и нашим серверам,
# грузить скрипты только с нашего домена и не умеет выполнять код из строк
# (eval). Если чужой код всё же попадёт на страницу, унести фразу на свой
# сервер запросом он не сможет. Добавляете новый узел или сервис в
# index.html — допишите его сюда, иначе браузер молча его отрежет.
# Пока идёт проверка, правило стоит в режиме «только сообщать» (Report-Only):
# ничего не блокирует, нарушения видны в консоли браузера.
/
  Cache-Control: no-cache
  Content-Security-Policy-Report-Only: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; connect-src 'self' https://*.tavarov.com https://tavarov.com https://api.coingecko.com https://*.publicnode.com https://*.drpc.org https://*.bnbchain.org https://*.binance.org https://1rpc.io https://mainnet.base.org https://polygon-rpc.com https://*.tatum.io https://*.trongrid.io https://*.jup.ag https://api.relay.link https://aggregator-api.kyberswap.com; frame-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

/index.html
  Cache-Control: no-cache
  Content-Security-Policy-Report-Only: default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; worker-src 'self' blob:; manifest-src 'self'; connect-src 'self' https://*.tavarov.com https://tavarov.com https://api.coingecko.com https://*.publicnode.com https://*.drpc.org https://*.bnbchain.org https://*.binance.org https://1rpc.io https://mainnet.base.org https://polygon-rpc.com https://*.tatum.io https://*.trongrid.io https://*.jup.ag https://api.relay.link https://aggregator-api.kyberswap.com; frame-src 'none'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'

/sw.js
  Cache-Control: no-cache

/manifest.json
  Cache-Control: no-cache

# Библиотеки не меняются годами и весят больше мегабайта — их можно держать
# в кэше сколько угодно.
/lib/*
  Cache-Control: public, max-age=31536000, immutable

# ПОЧЕМУ У КАЖДОЙ СТРАНИЦЫ ДВА ПРАВИЛА
#
# Cloudflare Pages сам уводит /pay.html на /pay — чистый адрес у него один.
# Правило, написанное на /pay.html, достаётся ответу-переадресации, а не
# странице: страница приезжает с заголовками только из /*. Для корня это
# когда-то заметили и написали и /, и /index.html; для остальных — нет.
# Поэтому ниже каждая страница перечислена в обоих написаниях.

/pay
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/pay.html
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/invoice
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff

/invoice.html
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff

# Страница печати наклейки. Правило про кэш здесь было забыто, и зря:
# страницу открывают раз в жизни, и открытая из кэша прошлогодняя версия
# напечатает прошлогоднюю наклейку — а висеть ей годами.
/sticker
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/sticker.html
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Страница донатов и её короткий адрес /d/имя (его отдаёт функция
# functions/d/[[path]].js). Правила те же, что у страницы оплаты.
/donate
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/donate.html
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/d/*
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Рисовалку кодов держим рядом с наклейкой: без неё страница печати
# показывает пустое место там, где должен быть код.
/qrcode.min.js
  Cache-Control: public, max-age=86400

# Ответ «оплачено ли» живёт секунды — из кэша он опасен.
/api/*
  Cache-Control: no-store

# Кабинет разработчика и документация API.
/dev
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/dev.html
  Cache-Control: no-cache
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Экран оповещений о донатах для OBS.
/alert
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

/alert.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Isolated creator dashboard assets. Existing wallet and payment policies are unchanged.
/creator/*
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
/creator
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'
