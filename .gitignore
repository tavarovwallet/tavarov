# Собранное и служебное — в репозитории ему нечего делать
node_modules/
.wrangler/
.netlify/
*.log

# Ключи подписи приложения. Один такой файл в открытом репозитории означает,
# что кто угодно может выпустить обновление «вашего» приложения.
*.jks
*.keystore
keystore.properties
.env
.env.*

# Собранное приложение
*.apk
*.aab
android/app/build/

# Снимки экрана, которые проверки audit/ пишут при каждом прогоне
audit/shots/
audit/out/

# Сборка расширения Chrome (python3 tools/build_extension.py)
/extension/
/NoN-Wallet-extension.zip
