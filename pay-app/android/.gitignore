# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Signing keys and their passwords. Never commit them: whoever has the key
# can publish an "update" of this app.
*.jks
*.keystore
keystore.properties
keystore.properties.*
!keystore.properties.example

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Libraries are downloaded by Gradle, never kept here
offline-maven/
offline-maven.zip

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (not used by this app)
google-services.json

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Android Profiling
*.hprof

# The till itself (../www) is copied here by ../sync-www.sh before each build
app/src/main/assets/public
