<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: nothing is backed up (allowBackup="false" too).
     The app keeps only the payout address and the local sales history. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
