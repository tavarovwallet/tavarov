<?xml version="1.0" encoding="utf-8"?>
<!--
  То же самое для Android 11 и старше: не выносить ничего. Пустой набор
  правил вместе с allowBackup="false" не оставляет резервной копии, из
  которой можно было бы достать хранилище кошелька.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
